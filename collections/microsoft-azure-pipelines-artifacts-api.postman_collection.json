                  "key": "api-version",
                  "value": "7.1",
                  "description": "(Required) Azure DevOps REST API version. Use 7.1 for the latest stable version."
                },
                {
                  "disabled": false,
                  "key": "artifactName",
                  "value": "<string>",
                  "description": "Filter by a specific artifact name"
                },
                {
                  "disabled": false,
                  "key": "$expand",
                  "value": "<string>",
                  "description": "Expand additional artifact details such as signed content"
